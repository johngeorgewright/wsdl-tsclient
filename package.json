{
  "name": "@johngw/wsdl-tsclient",
  "version": "2.0.0",
  "description": "Generate typescript soap client with typescript definitions from WSDL file.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "wsdl-tsclient": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "pretest": "rm -rf ./test/generated",
    "test": "vitest run",
    "preversion": "npm test && npm run build",
    "prepublishOnly": "npm test && npm run dist",
    "dev": "vite-node ./dev.ts",
    "dist": "tsc",
    "build": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johngeorgewright/wsdl-tsclient.git"
  },
  "keywords": [
    "soap",
    "soap-client",
    "wsdl",
    "wsdl-client",
    "typescript"
  ],
  "author": "John Wright <johngeorgewright+git@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/johngeorgewright/wsdl-tsclient/issues"
  },
  "homepage": "https://github.com/johngeorgewright/wsdl-tsclient#readme",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/supports-color": "^8.1.3",
    "@types/yargs": "^17.0.32",
    "eslint-plugin-prettier": "^4.0.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.2"
  },
  "dependencies": {
    "camelcase": "^6.3.0",
    "chalk": "^4.1.1",
    "sanitize-filename": "^1.6.3",
    "soap": "^1.1.0",
    "supports-color": "^8.1.1",
    "ts-morph": "^23.0.0",
    "yargs": "^17.7.2"
  }
}
